DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"
# Optional email notifications (off when unset):
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# SMTP_FROM="Kanbun <kanbun@example.com>"
# Optional: where card attachments are stored (default: next to the database) and the per-file limit.
# ATTACHMENTS_DIR="/data/attachments"
# ATTACHMENT_MAX_MB="10"
# Optional: REST API requests per token per minute (default 120).
# API_RATE_LIMIT="120"
# Optional: let webhooks reach private/loopback addresses (off by default).
# WEBHOOK_ALLOW_PRIVATE="1"
# Optional single sign-on with an OpenID Connect provider (off when unset). See docs/SSO.md.
# Redirect URI to register in the provider: <NEXTAUTH_URL>/api/auth/callback/oidc
# OIDC_ISSUER="https://authentik.example.com/application/o/kanbun/"
# OIDC_CLIENT_ID="kanbun"
# OIDC_CLIENT_SECRET="change-me"
# OIDC_NAME="Authentik"
# OIDC_SCOPES="openid profile email"
# Create a member account on the first SSO login (default false: existing users only).
# OIDC_ALLOW_SIGNUP="false"
# Members of this group (groups claim) become admins, others members.
# OIDC_ADMIN_GROUP="kanbun-admins"
# Also link by preferred_username = Kanbun username (only if users can not pick their IdP username).
# OIDC_MATCH_USERNAME="false"
# Hide the password form; admins can still use /login?local=1 as break-glass.
# OIDC_DISABLE_PASSWORD="false"
