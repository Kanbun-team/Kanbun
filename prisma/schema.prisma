generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  username         String   @unique
  passwordHash     String
  displayName      String?
  avatarUrl        String?
  role             String   @default("member")
  themePreference  String   @default("system")
  locale           String   @default("en")
  // Bumped to invalidate every outstanding JWT for this user (e.g. after an
  // admin password reset). Compared against the value stored in the token.
  sessionVersion   Int      @default(0)
  // Set when an admin deactivates the account: the user can no longer sign in
  // and is hidden from pickers, but everything they created stays.
  deactivatedAt    DateTime?
  // Optional address for notification emails (only used when SMTP is set up).
  email            String?
  // JSON object { [notificationType]: "inapp" | "email" | "none" }. Missing
  // types fall back to "inapp". See src/lib/notification-prefs.ts.
  notificationPrefs String  @default("{}")
  // Daily email summary of unread notifications, off by default.
  digestEnabled    Boolean  @default(false)
  digestSentAt     DateTime?
  // Two-factor authentication (TOTP, src/lib/totp.ts). The secret is
  // AES-256-GCM encrypted with a key derived from AUTH_SECRET. A secret
  // without totpEnabledAt is a setup that was started but not confirmed.
  totpSecret       String?
  totpEnabledAt    DateTime?
  // Last accepted time step, so a code can not be used twice.
  totpLastStep     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  boards            BoardMember[]
  createdBoards     Board[]              @relation("BoardCreator")
  createdCards      TaskCard[]           @relation("CardCreator")
  cardAssignments   TaskCardAssignee[]
  taskComments      TaskCardComment[]
  completedSubtasks TaskSubtask[]        @relation("SubtaskCompleter")
  createdBlocks     TaskBlock[]          @relation("BlockCreator")
  taskMoves         TaskCardMoveEvent[]  @relation("MoveActor")
  sessions          UserSession[]
  notifications     Notification[]       @relation("UserNotifications")
  boardPins         BoardPin[]
  savedFilters      SavedFilter[]        @relation("SavedFilterCreator")
  cardActivities    CardActivity[]       @relation("CardActivityActor")
  cardWatches       CardWatcher[]
  boardWatches      BoardWatcher[]
  assignedSubtasks  TaskSubtask[]        @relation("SubtaskAssignee")
  attachments       CardAttachment[]     @relation("AttachmentUploader")
  cardTemplates     CardTemplate[]       @relation("CardTemplateCreator")
  cardRecurrences   CardRecurrence[]     @relation("CardRecurrenceCreator")
  apiTokens         ApiToken[]
  webhooks          Webhook[]            @relation("WebhookCreator")
  identities        UserIdentity[]
  recoveryCodes     TotpRecoveryCode[]
  automationRules   AutomationRule[]     @relation("AutomationRuleCreator")
}

// A single sign-on (OIDC) identity linked to a user: provider is the Auth.js
// provider id, subject the IdP's stable `sub` claim.
model UserIdentity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

// Single-use 2FA recovery codes, stored as keyed hashes.
model TotpRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Board {
  id           String   @id @default(cuid())
  name         String
  description  String?
  color        String   @default("#2563eb")
  position     Int      @default(0)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  createdBy    User?    @relation("BoardCreator", fields: [createdById], references: [id], onDelete: SetNull)

  categoryId String?
  category   BoardCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  members BoardMember[]
  columns BoardColumn[]
  tags    BoardTag[]

  @@index([createdById])
  @@index([categoryId, position])
  pins BoardPin[]
  watchers BoardWatcher[]
  savedFilters SavedFilter[]
  cardTemplates CardTemplate[]
  cardRecurrences CardRecurrence[]
  webhooks Webhook[]
  automationRules AutomationRule[]
}

model BoardCategory {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#64748b")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  boards Board[]
}

model BoardMember {
  boardId String
  userId  String
  role    String   @default("member")
  addedAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
}

model BoardColumn {
  id       String @id @default(cuid())
  boardId  String
  name     String
  position Int
  wipLimit Int?

  board       Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards       TaskCard[]
  recurrences CardRecurrence[]

  @@index([boardId, position])
}

model TaskCard {
  id          String   @id @default(cuid())
  columnId    String
  title       String
  description String?
  position    Int
  priority    String   @default("normal")
  coverColor  String?
  deadline    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  column     BoardColumn        @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation("CardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignees  TaskCardAssignee[]
  comments   TaskCardComment[]
  subtasks   TaskSubtask[]
  tags       TaskCardTag[]
  blocking   TaskBlock[]        @relation("CardBlocker")
  blockedBy  TaskBlock[]        @relation("CardBlocked")
  watchers   CardWatcher[]
  attachments CardAttachment[]

  @@index([columnId, position])
  @@index([createdById])
}

model BoardTag {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  board Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards TaskCardTag[]

  @@index([boardId])
}

model TaskCardTag {
  cardId String
  tagId  String

  card TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag  BoardTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@index([tagId])
}

model TaskBlock {
  id          String   @id @default(cuid())
  blockerId   String
  blockedId   String
  createdAt   DateTime @default(now())
  createdById String?

  blocker   TaskCard @relation("CardBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   TaskCard @relation("CardBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("BlockCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model TaskSubtask {
  id              String    @id @default(cuid())
  cardId          String
  title           String
  done            Boolean   @default(false)
  position        Int
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  completedById   String?
  assigneeId      String?
  // A calendar date stored as UTC midnight, like TaskCard.deadline.
  dueDate         DateTime?

  card        TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  completedBy User?    @relation("SubtaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  assignee    User?    @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([cardId, position])
  @@index([assigneeId])
}

// A file on a card. The bytes live on disk under the attachments directory
// (see src/server/attachment-storage.ts) at a random `storageKey`; the row
// only keeps metadata. Trashing the card keeps the file so a restore brings
// it back; the file is removed with the attachment or when the trash item is
// purged.
model CardAttachment {
  id         String   @id @default(cuid())
  cardId     String
  uploaderId String?
  fileName   String
  mimeType   String
  size       Int
  storageKey String   @unique
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  card     TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploader User?    @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
}

model TaskCardAssignee {
  cardId String
  userId String

  card TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
}

model TaskCardComment {
  id        String   @id @default(cuid())
  cardId    String
  authorId  String?
  body      String
  /// Set by the client once per comment it sends, so a retried send (dropped
  /// connection, offline outbox replay) returns the first comment instead of
  /// posting it twice.
  clientKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card   TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([cardId, clientKey])
  @@index([cardId, createdAt])
  @@index([authorId, createdAt])
}

model TaskCardMoveEvent {
  id              String   @id @default(cuid())
  cardId          String
  cardTitle       String
  boardId         String
  fromColumnName  String?
  toColumnName    String
  userId          String?
  createdAt       DateTime @default(now())

  user User? @relation("MoveActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  cardId    String?
  cardTitle String
  boardId   String?
  actorId   String?
  actorName String?
  // JSON object of extra text for the message, e.g. {"column":"Done"} for a
  // move or {"count":"5","board":"Website"} for cards added together.
  data      String?

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  deviceType  String   @default("web")
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
}

// Deleted cards, columns and boards. The full subtree is stored as JSON so it
// can be restored (with its original ids) for 30 days; live tables never hold
// soft-deleted rows, so no query has to filter them out.
model TrashItem {
  id          String   @id @default(cuid())
  kind        String // "card" | "column" | "board"
  entityId    String
  boardId     String
  label       String
  payload     String
  deletedById String?
  deletedAt   DateTime @default(now())

  @@index([boardId, deletedAt])
  @@index([deletedAt])
}

// A board a user starred to keep at the top of the boards home. Pins are not
// part of the trash snapshot: deleting a board drops them and a restore simply
// comes back unpinned.
model BoardPin {
  userId    String
  boardId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([userId, boardId])
  @@index([boardId])
}

// A named filter shared with everyone on the board. `filters` is the JSON of
// the board filter state (validated with zod when read and written).
model SavedFilter {
  id          String   @id @default(cuid())
  boardId     String
  name        String
  filters     String
  createdById String?
  createdAt   DateTime @default(now())

  board     Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy User? @relation("SavedFilterCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
}

// Card history: who changed what and when. No relation to TaskCard, so the
// history survives while the card sits in the trash (it is restored with its
// original id). `data` is a JSON object whose shape depends on `type`.
model CardActivity {
  id        String   @id @default(cuid())
  cardId    String
  boardId   String
  type      String
  data      String   @default("{}")
  actorId   String?
  createdAt DateTime @default(now())

  actor User? @relation("CardActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
}

// Users following a card: notified about new comments, moves to another
// column and an approaching deadline. Part of the card trash snapshot.
model CardWatcher {
  cardId    String
  userId    String
  createdAt DateTime @default(now())

  card TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
}

// Users following a board: notified about new cards on it.
model BoardWatcher {
  boardId   String
  userId    String
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
}

// Marker for the dueSoon job: the deadline value a card was last notified
// about, so each deadline is announced once. No relation, so it survives the
// card sitting in the trash; a changed deadline is announced again.
model DueSoonNotice {
  cardId   String   @id
  deadline DateTime
  sentAt   DateTime @default(now())
}

// A reusable card on a board: "New card from template" copies these fields
// into a new card. `tagIds` is a JSON array of BoardTag ids (ids of tags
// deleted since are skipped when used) and `checklist` a JSON array of
// checklist item titles.
model CardTemplate {
  id          String   @id @default(cuid())
  boardId     String
  name        String
  title       String
  description String?
  priority    String   @default("normal")
  tagIds      String   @default("[]")
  checklist   String   @default("[]")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  board       Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation("CardTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recurrences CardRecurrence[]

  @@index([boardId, name])
}

// A schedule that creates a card from a template on a repeating rule. The
// background job (src/server/jobs/recurring.ts) picks up active rows whose
// nextRunAt has passed. Deleting the template or the column nulls the
// reference and the job then deactivates the schedule.
model CardRecurrence {
  id          String    @id @default(cuid())
  boardId     String
  templateId  String?
  columnId    String?
  // "daily" | "weekly" | "monthly"
  rule        String
  // 0 (Sunday) to 6, for weekly rules.
  weekday     Int?
  // 1 to 31, for monthly rules; a day past the end of a month means its last day.
  monthDay    Int?
  // "HH:MM" in the server's time zone; null means midnight.
  timeOfDay   String?
  nextRunAt   DateTime
  lastRunAt   DateTime?
  active      Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())

  board     Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  template  CardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  column    BoardColumn?  @relation(fields: [columnId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("CardRecurrenceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active, nextRunAt])
  @@index([boardId])
  @@index([templateId])
  @@index([columnId])
}

// Security-relevant events for the admin audit log (logins, role changes,
// deletions, tokens, imports). No foreign key on purpose: entries outlive the
// users and objects they mention. `details` is a JSON object.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  action     String
  targetType String?
  targetId   String?
  targetName String?
  details    String   @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

// Personal access token for the REST API (/api/v1). Only the SHA-256 hash of
// the token is stored; `prefix` is its first characters, shown in the UI so a
// user can tell tokens apart. `scopes` is "read" or "write" (write includes
// read). A token acts with its user's permissions and stops working when the
// user is deactivated, the token is revoked or it expires.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  prefix     String
  scopes     String    @default("read")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Outgoing webhook of a board, managed by its owners. `events` is a JSON array
// of event names (see src/lib/webhooks.ts). `secret` signs every delivery
// (HMAC-SHA256). `failureCount` counts consecutive failed deliveries; the
// webhook is switched off when it reaches the limit. Part of the board trash
// snapshot (its deliveries are not).
model Webhook {
  id              String    @id @default(cuid())
  boardId         String
  url             String
  secret          String
  events          String    @default("[]")
  active          Boolean   @default(true)
  createdById     String?
  // HTTP status of the last delivery; 0 when no response came back.
  lastStatus      Int?
  lastDeliveredAt DateTime?
  failureCount    Int       @default(0)
  createdAt       DateTime  @default(now())

  board      Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@index([boardId])
}

// Webhook deliveries: the durable outbox and the "Recent deliveries" list.
// A row starts `pending` with its signed body in `payload` and is sent by
// src/server/webhooks.ts; it ends `success` or `failed` (payload cleared).
// The id is the X-Kanbun-Delivery header. Finished rows are pruned to the
// last WEBHOOK_HISTORY per webhook.
model WebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String
  event         String
  // pending | success | failed
  status        String    @default("pending")
  // The exact JSON body to send; null once the delivery is finished.
  payload       String?
  // When a pending delivery is due. A worker that claims it pushes this
  // forward (a lease), so a crashed send is retried later.
  nextAttemptAt DateTime?
  success       Boolean   @default(false)
  statusCode    Int?
  durationMs    Int?
  error         String?
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([status, nextAttemptAt])
}

// A board automation rule (see src/lib/automations.ts), managed by board
// owners and admins. `trigger` is "cardEntersColumn" (with `columnId`) or
// "deadlinePassed"; `actions` is a JSON array of actions. Column, tag and user
// ids (here and inside `actions`) are not foreign keys: a rule whose column
// was deleted stops firing and works again when the column is restored from
// the trash. Part of the board trash snapshot and the board export.
model AutomationRule {
  id          String   @id @default(cuid())
  boardId     String
  name        String
  trigger     String
  columnId    String?
  actions     String   @default("[]")
  enabled     Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  board     Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AutomationRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
  @@index([trigger, enabled])
}

// One run of an automation rule on a card. `changes` is the JSON list of what
// the rule changed, which is what "Undo" reverts (`undoneAt` is set then).
// `dedupeKey` is set for deadline runs ("<ruleId>:<cardId>:<deadline>"), so
// each deadline is handled once, even with several instances. No relations,
// like CardActivity: the row outlives the rule, and the card in the trash.
model AutomationRun {
  id        String    @id @default(cuid())
  ruleId    String
  ruleName  String
  boardId   String
  cardId    String
  trigger   String
  changes   String    @default("[]")
  dedupeKey String?   @unique
  actorId   String?
  undoneAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([cardId, createdAt])
}
